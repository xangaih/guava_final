# Guava sandbox (from app.goguava.ai -> API Keys / Phone Numbers)
GUAVA_API_KEY=
GUAVA_AGENT_NUMBER=

# Supabase (Project Settings -> API Keys). The SECRET key stays on the server (the FastAPI backend only).
# Credentials live ONLY in .env, which is git-ignored. Never paste them into a file that gets committed, or into chat.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Mock claims backend (FastAPI)
BACKEND_BASE_URL=http://127.0.0.1:8000
BACKEND_API_KEY=change-me-demo-key
ADMIN_TOKEN=change-me-admin-token

# Transfer destinations. For the demo, use a phone you control.
HUMAN_LINE_NUMBER=
ROADSIDE_LINE_NUMBER=

# SMS confirmation of the claim number (C15). Leave false until the SMS test passes on the phone you will demo with.
SMS_CONFIRMATION_ENABLED=false
